{
    "name": "Logins",
    "routePrefix": "system.logins",
    "crtNo": true,
    "defaultSort": "logins.created_at",
    "defaultSortDirection": "desc",
    "buttons": [
        "excel"
    ],
    "columns": [
        {
            "label": "Name",
            "name": "name",
            "data": "people.name",
            "meta": [
                "searchable",
                "sortable"
            ]
        },
        {
            "label": "Email",
            "name": "email",
            "data": "users.email",
            "meta": [
                "searchable",
                "sortable"
            ]
        },
        {
            "label": "Role",
            "name": "role",
            "data": "roles.name",
            "meta": [
                "searchable",
                "sortable",
                "slot"
            ]
        },
        {
            "label": "IP",
            "name": "ip",
            "data": "logins.ip",
            "meta": [
                "searchable",
                "sortable"
            ],
            "class": "is-number"
        },
        {
            "label": "User Agent",
            "name": "user_agent",
            "data": "logins.user_agent",
            "meta": [
                "searchable",
                "sortable"
            ]
        },
        {
            "label": "",
            "name": "avatar",
            "data": "user",
            "resource": "LaravelEnso\\Users\\Http\\Resources\\User",
            "meta": [
                "slot",
                "notExportable"
            ],
            "class": "is-paddingless"
        },
        {
            "label": "Created at",
            "name": "created_at",
            "data": "logins.created_at",
            "meta": [
                "sortable",
                "datetime"
            ]
        }
    ]
}
